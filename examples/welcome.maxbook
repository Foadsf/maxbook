   {
    "type": "heading",
    "attrs": {
     "level": 2
    },
    "content": [
     {
      "type": "text",
      "text": "Long computations"
     }
    ]
   },
   {
    "type": "paragraph",
    "content": [
     {
      "type": "text",
      "text": "Stop",
      "marks": [
       {
        "type": "strong"
       }
      ]
     },
     {
      "type": "text",
      "text": " interrupts a computation and Maxima keeps everything defined so far; "
     },
     {
      "type": "text",
      "text": "Restart",
      "marks": [
       {
        "type": "strong"
       }
      ]
     },
     {
      "type": "text",
      "text": " starts a fresh Maxima."
     }
    ]
   },
   {
    "type": "heading",
    "attrs": {
     "level": 2
    },
    "content": [
     {
      "type": "text",
      "text": "Working together"
     }
    ]
   },
   {
    "type": "paragraph",
    "content": [
     {
      "type": "text",
      "text": "Other windows on this computer stay in sync. Start Maxbook with "
     },
     {
      "type": "text",
      "text": "--share",
      "marks": [
       {
        "type": "code"
       }
      ]
     },
     {
      "type": "text",
      "text": " to edit a notebook with others on your network: they can write, while only you run Maxima and save."
     }
    ]
   },
   {
    "type": "heading",
    "attrs": {
     "level": 2
    },
    "content": [
     {
      "type": "text",
      "text": "Sharing your work"
     }
    ]
   },
   {
    "type": "paragraph",
    "content": [
     {
      "type": "text",
      "text": "Export",
      "marks": [
       {
        "type": "strong"
       }
      ]
     },
     {
      "type": "text",
      "text": " writes LaTeX (with figures), a self-contained HTML page, Markdown, a Maxima batch file or a wxMaxima document. wxMaxima ("
     },
     {
      "type": "text",
      "text": ".wxm",
      "marks": [
       {
        "type": "code"
       }
      ]
     },
     {
      "type": "text",
      "text": ", "
     },
     {
      "type": "text",
      "text": ".wxmx",
      "marks": [
       {
        "type": "code"
       }
      ]
     },
     {
      "type": "text",
      "text": "), Maxima, Markdown and LaTeX files open directly."
     }
    ]
   },
   {
    "type": "paragraph"
   }
  ]
