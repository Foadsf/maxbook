{
 "format": "maxbook",
 "version": 2,
 "title": "Welcome to Maxbook",
 "doc": {
  "type": "doc",
  "attrs": {
   "title": "Welcome to Maxbook",
   "symbols": {
    "f": {
     "description": "The example function x² sin x, defined below"
    },
    "A": {
     "description": "A symmetric 2×2 matrix"
    }
   }
  },
  "content": [
   {
    "type": "heading",
    "attrs": {
     "level": 1
    },
    "content": [
     {
      "type": "text",
      "text": "Welcome to Maxbook"
     }
    ]
   },
   {
    "type": "paragraph",
    "content": [
     {
      "type": "text",
      "text": "Maxbook is a notebook for "
     },
     {
      "type": "text",
      "text": "literate computing with Maxima",
      "marks": [
       {
        "type": "strong"
       }
      ]
     },
     {
      "type": "text",
      "text": ": one continuous document in which prose, formulas and computations live together. Write as you would write a paper; Maxima does the algebra."
     }
    ]
   },
   {
    "type": "heading",
    "attrs": {
     "level": 2
    },
    "content": [
     {
      "type": "text",
      "text": "Formulas in the text"
     }
    ]
   },
   {
    "type": "paragraph",
    "content": [
     {
      "type": "text",
      "text": "Type "
     },
     {
      "type": "text",
      "text": "$",
      "marks": [
       {
        "type": "code"
       }
      ]
     },
     {
      "type": "text",
      "text": " to write a formula inside a sentence, such as "
     },
     {
      "type": "math_inline",
      "attrs": {
       "id": "52bc5ae465f6",
       "latex": "e^{i\\pi}+1=0",
       "source": "",
       "result": null
      }
     },
     {
      "type": "text",
      "text": ". End a formula with "
     },
     {
      "type": "text",
      "text": "=",
      "marks": [
       {
        "type": "code"
       }
      ]
     },
     {
      "type": "text",
      "text": " and press "
     },
     {
      "type": "text",
      "text": "Tab",
      "marks": [
       {
        "type": "strong"
       }
      ]
     },
     {
      "type": "text",
      "text": ", and Maxima writes the result in place: "
     },
     {
      "type": "math_inline",
      "attrs": {
       "id": "e4edcb4038e9",
       "latex": "\\int_0^1x^2\\,dx=",
       "source": "integrate(x^2, x, 0, 1);",
       "result": {
        "latex": "\\frac{1}{3}",
        "semantic": "\\frac{1}{3}",
        "text": "1/3"
       }
      }
     },
     {
      "type": "text",
      "text": " and "
     },
     {
      "type": "math_inline",
      "attrs": {
       "id": "d04550595ed9",
       "latex": "\\sum_{k=1}^{\\infty}\\frac{1}{k^2}=",
       "source": "sum(1/k^2, k, 1, inf);",
       "result": {
        "latex": "\\frac{\\pi^2}{6}",
        "semantic": "\\frac{\\class{mbk-sym mbk-constant mbk-n-002500700069}{\\pi}^2}{6}",
        "text": "%pi^2/6"
       }
      }
     },
     {
      "type": "text",
      "text": ". Type "
     },
     {
      "type": "text",
      "text": "$",
      "marks": [
       {
        "type": "code"
       }
      ]
     },
     {
      "type": "text",
      "text": " twice for a display formula:"
     }
    ]
   },
   {
    "type": "math_block",
    "attrs": {
     "id": "66dcfe03a2c8",
     "source": "",
     "outputs": [],
     "inputs": [],
     "latex": "\\int_0^{\\infty}e^{-x^2}\\,dx=\\frac{\\sqrt{\\pi}}{2}",
     "run": false,
     "result": null
    }
   },
   {
    "type": "heading",
    "attrs": {
     "level": 2
    },
    "content": [
     {
      "type": "text",
      "text": "Definitions"
     }
    ]
   },
   {
    "type": "paragraph",
    "content": [
     {
      "type": "text",
      "text": ":=",
      "marks": [
       {
        "type": "code"
       }
      ]
     },
     {
      "type": "text",
      "text": " and "
     },
     {
      "type": "text",
      "text": "Tab",
      "marks": [
       {
        "type": "strong"
       }
      ]
     },
     {
      "type": "text",
      "text": " defines a variable or a function in Maxima:"
     }
    ]
   },
   {
    "type": "math_block",
    "attrs": {
     "id": "538a5e9f3377",
     "source": "f(x) := x^2*sin(x);",
     "outputs": [],
     "inputs": [],
     "latex": "f\\left(x\\right)\\coloneq x^2\\sin x",
     "run": false,
     "result": {
      "text": "defined"
     }
    }
   },
   {
    "type": "paragraph",
    "content": [
     {
      "type": "text",
      "text": "From then on every formula and Maxima block can use it, for example "
     },
     {
      "type": "math_inline",
      "attrs": {
       "id": "ab66138295d9",
       "latex": "f\\left(\\frac{\\pi}{2}\\right)=",
       "source": "f(%pi/2);",
       "result": {
        "latex": "\\frac{\\pi^2}{4}",
        "semantic": "\\frac{\\class{mbk-sym mbk-constant mbk-n-002500700069}{\\pi}^2}{4}",
        "text": "%pi^2/4"
       }
      }
     },
     {
      "type": "text",
      "text": "."
     }
    ]
   },
   {
    "type": "heading",
    "attrs": {
     "level": 2
    },
    "content": [
     {
      "type": "text",
      "text": "Maxima blocks"
     }
    ]
   },
   {
    "type": "paragraph",
    "content": [
     {
      "type": "text",
      "text": "Type "
     },
     {
      "type": "text",
      "text": ">>",
      "marks": [
       {
        "type": "code"
       }
      ]
     },
     {
      "type": "text",
      "text": " and a space for a block of ordinary Maxima input. "
     },
     {
      "type": "text",
      "text": "Shift+Enter",
      "marks": [
       {
        "type": "strong"
       }
      ]
     },
     {
      "type": "text",
      "text": " runs it; each result keeps its "
     },
     {
      "type": "text",
      "text": "%o",
      "marks": [
       {
        "type": "code"
       }
      ]
     },
     {
      "type": "text",
      "text": " label and can be copied as LaTeX or as Maxima text."
     }
    ]
   },
   {
    "type": "maxima",
    "attrs": {
     "id": "95981dd5e3df",
     "source": "integrate(f(x), x);\ndiff(f(x), x, 2);",
     "outputs": [
      {
       "kind": "result",
       "label": "%o5",
       "latex": "2\\,x\\,\\sin x+\\left(2-x^2\\right)\\,\\cos x",
       "text": "2*x*sin(x)+(2-x^2)*cos(x)",
       "semantic": "2\\,\\class{mbk-sym mbk-free mbk-n-0078}{x}\\,\\sin \\class{mbk-sym mbk-free mbk-n-0078}{x}+\\left(2-\\class{mbk-sym mbk-free mbk-n-0078}{x}^2\\right)\\,\\cos \\class{mbk-sym mbk-free mbk-n-0078}{x}"
      },
      {
       "kind": "result",
       "label": "%o6",
       "latex": "-\\left(x^2\\,\\sin x\\right)+2\\,\\sin x+4\\,x\\,\\cos x",
       "text": "-(x^2*sin(x))+2*sin(x)+4*x*cos(x)",
       "semantic": "-\\left(\\class{mbk-sym mbk-free mbk-n-0078}{x}^2\\,\\sin \\class{mbk-sym mbk-free mbk-n-0078}{x}\\right)+2\\,\\sin \\class{mbk-sym mbk-free mbk-n-0078}{x}+4\\,\\class{mbk-sym mbk-free mbk-n-0078}{x}\\,\\cos \\class{mbk-sym mbk-free mbk-n-0078}{x}"
      }
     ],
     "inputs": [
      5,
      6
     ]
    }
   },
   {
    "type": "heading",
    "attrs": {
     "level": 2
    },
    "content": [
     {
      "type": "text",
      "text": "Symbols"
     }
    ]
   },
   {
    "type": "paragraph",
    "content": [
     {
      "type": "text",
      "text": "Every name has its own colour in formulas and results, and constants such as "
     },
     {
      "type": "math_inline",
      "attrs": {
       "id": "ad7fb5e25796",
       "latex": "\\pi",
       "source": "",
       "result": null
      }
     },
     {
      "type": "text",
      "text": " are marked. Hover a symbol to see what Maxima knows about it. The "
     },
     {
      "type": "text",
      "text": "Objects",
      "marks": [
       {
        "type": "strong"
       }
      ]
     },
     {
      "type": "text",
      "text": " panel lists the variables and functions of the session; ✎ adds a description that is saved in the notebook."
     }
    ]
   },
   {
    "type": "maxima",
    "attrs": {
     "id": "7404d0d2cdcc",
     "source": "A: matrix([2, 1], [1, 3])$\neigenvalues(A);\nA^^-1;",
     "outputs": [
      {
       "kind": "result",
       "label": "%o8",
       "latex": "\\left[ \\left[ -\\left(\\frac{\\sqrt{5}-5}{2}\\right) , \\frac{\\sqrt{5}+5}{2} \\right]  , \\left[ 1 , 1 \\right]  \\right]",
       "text": "[[-((sqrt(5)-5)/2),(sqrt(5)+5)/2],[1,1]]"
      },
      {
       "kind": "result",
       "label": "%o9",
       "latex": "\\begin{pmatrix} \\frac{3}{5}&-\\left(\\frac{1}{5}\\right)\\\\ -\\left(\\frac{1}{5}\\right)&\\frac{2}{5}\\end{pmatrix}",
       "text": "matrix([3/5,-(1/5)],[-(1/5),2/5])"
      }
     ],
     "inputs": [
      7,
      8,
      9
     ]
    }
   },
   {
    "type": "heading",
    "attrs": {
     "level": 2
    },
    "content": [
     {
      "type": "text",
      "text": "Menus"
     }
    ]
   },
   {
    "type": "paragraph",
    "content": [
     {
      "type": "text",
      "text": "The "
     },
     {
      "type": "text",
      "text": "Equations",
      "marks": [
       {
        "type": "strong"
       }
      ]
     },
     {
      "type": "text",
      "text": ", "
     },
     {
      "type": "text",
      "text": "Algebra",
      "marks": [
       {
        "type": "strong"
       }
      ]
     },
     {
      "type": "text",
      "text": ", "
     },
     {
      "type": "text",
      "text": "Calculus",
      "marks": [
       {
        "type": "strong"
       }
      ]
     },
     {
      "type": "text",
      "text": ", "
     },
     {
      "type": "text",
      "text": "Matrix",
      "marks": [
       {
        "type": "strong"
       }
      ]
     },
     {
      "type": "text",
      "text": " and "
     },
     {
      "type": "text",
      "text": "Plot",
      "marks": [
       {
        "type": "strong"
       }
      ]
     },
     {
      "type": "text",
      "text": " menus open short forms that write the Maxima code for you. "
     },
     {
      "type": "text",
      "text": "Ctrl+K",
      "marks": [
       {
        "type": "strong"
       }
      ]
     },
     {
      "type": "text",
      "text": " searches all commands, forms and formula templates."
     }
    ]
   },
   {
    "type": "heading",
    "attrs": {
     "level": 2
    },
    "content": [
     {
      "type": "text",
      "text": "Inline plots"
     }
    ]
   },
   {
    "type": "paragraph",
    "content": [
     {
      "type": "text",
      "text": "iplot2d",
      "marks": [
       {
        "type": "code"
       }
      ]
     },
     {
      "type": "text",
      "text": ", "
     },
     {
      "type": "text",
      "text": "iplot3d",
      "marks": [
       {
        "type": "code"
       }
      ]
     },
     {
      "type": "text",
      "text": ", "
     },
     {
      "type": "text",
      "text": "idraw2d",
      "marks": [
       {
        "type": "code"
       }
      ]
     },
     {
      "type": "text",
      "text": " and "
     },
     {
      "type": "text",
      "text": "idraw3d",
      "marks": [
       {
        "type": "code"
       }
      ]
     },
     {
      "type": "text",
      "text": " take the arguments of "
     },
     {
      "type": "text",
      "text": "plot2d",
      "marks": [
       {
        "type": "code"
       }
      ]
     },
     {
      "type": "text",
      "text": ", "
     },
     {
      "type": "text",
      "text": "plot3d",
      "marks": [
       {
        "type": "code"
       }
      ]
     },
     {
      "type": "text",
      "text": ", "
     },
     {
      "type": "text",
      "text": "draw2d",
      "marks": [
       {
        "type": "code"
       }
      ]
     },
     {
      "type": "text",
      "text": " and "
     },
     {
      "type": "text",
      "text": "draw3d",
      "marks": [
       {
        "type": "code"
       }
      ]
     },
     {
      "type": "text",
      "text": " and draw into the notebook. Worksheets written for wxMaxima keep working: "
     },
     {
      "type": "text",
      "text": "wxplot2d",
      "marks": [
       {
        "type": "code"
       }
      ]
     },
     {
      "type": "text",
      "text": " and friends are aliases."
     }
    ]
   },
   {
    "type": "maxima",
    "attrs": {
     "id": "d54c84ae2749",
     "source": "iplot2d([sin(x), cos(2*x)/2], [x, -2*%pi, 2*%pi])$",
     "outputs": [
      {
       "kind": "image",
       "mime": "image/svg+xml",
       "data": "<?xml version=\"1.0\" encoding=\"windows-1252\"  standalone=\"no\"?>\n<svg \n width=\"600\" height=\"480\"\n viewBox=\"0 0 600 480\"\n xmlns=\"http://www.w3.org/2000/svg\"\n xmlns:xlink=\"http://www.w3.org/1999/xlink\"\n>\n\n<title>Gnuplot</title>\n<desc>Produced by GNUPLOT 6.0 patchlevel 5 </desc>\n\n<g id=\"gnuplot_canvas\">\n\n<rect x=\"0\" y=\"0\" width=\"600\" height=\"480\" fill=\"none\"/>\n<defs>\n\n\t<circle id='gpDot' r='0.5' stroke-width='0.5' stroke='currentColor'/>\n\t<path id='gpPt0' stroke-width='0.222' stroke='currentColor' d='M-1,0 h2 M0,-1 v2'/>\n\t<path id='gpPt1' stroke-width='0.222' stroke='currentColor' d='M-1,-1 L1,1 M1,-1 L-1,1'/>\n\t<path id='gpPt2' stroke-width='0.222' stroke='currentColor' d='M-1,0 L1,0 M0,-1 L0,1 M-1,-1 L1,1 M-1,1 L1,-1'/>\n\t<rect id='gpPt3' stroke-width='0.222' stroke='currentColor' x='-1' y='-1' width='2' height='2'/>\n\t<rect id='gpPt4' stroke-width='0.222' stroke='currentColor' fill='currentColor' x='-1' y='-1' width='2' height='2'/>\n\t<circle id='gpPt5' stroke-width='0.222' stroke='currentColor' cx='0' cy='0' r='1'/>\n\t<use xlink:href='#gpPt5' id='gpPt6' fill='currentColor' stroke='none'/>\n\t<path id='gpPt7' stroke-width='0.222' stroke='currentColor' d='M0,-1.33 L-1.33,0.67 L1.33,0.67 z'/>\n\t<use xlink:href='#gpPt7' id='gpPt8' fill='currentColor' stroke='none'/>\n\t<use xlink:href='#gpPt7' id='gpPt9' stroke='currentColor' transform='rotate(180)'/>\n\t<use xlink:href='#gpPt9' id='gpPt10' fill='currentColor' stroke='none'/>\n\t<use xlink:href='#gpPt3' id='gpPt11' stroke='currentColor' transform='rotate(45)'/>\n\t<use xlink:href='#gpPt11' id='gpPt12' fill='currentColor' stroke='none'/>\n\t<path id='gpPt13' stroke-width='0.222' stroke='currentColor' d='M0,1.330 L1.265,0.411 L0.782,-1.067 L-0.782,-1.076 L-1.265,0.411 z'/>\n\t<use xlink:href='#gpPt13' id='gpPt14' fill='currentColor' stroke='none'/>\n\t<filter id='textbox' filterUnits='objectBoundingBox' x='0' y='0' height='1' width='1'>\n\t  <feFlood fl