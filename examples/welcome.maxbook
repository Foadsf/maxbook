    "content": [
     {
      "type": "text",
      "text": "Questions from Maxima"
     }
    ]
   },
   {
    "type": "paragraph",
    "content": [
     {
      "type": "text",
      "text": "Sometimes Maxima needs to know more, for example the sign of a parameter. The question appears in the notebook; answer it there."
     }
    ]
   },
   {
    "type": "maxima",
    "attrs": {
     "id": "945b964312fc",
     "source": "integrate(x^a, x);",
     "outputs": [
      {
       "kind": "text",
       "text": "» no"
      },
      {
       "kind": "result",
       "label": "%o11",
       "latex": "\\frac{x^{a+1}}{a+1}",
       "text": "x^(a+1)/(a+1)",
       "semantic": "\\frac{\\class{mbk-sym mbk-free mbk-n-0078}{x}^{\\class{mbk-sym mbk-free mbk-n-0061}{a}+1}}{\\class{mbk-sym mbk-free mbk-n-0061}{a}+1}"
